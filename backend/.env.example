# All settings are OPTIONAL. MyKshema runs with no database and no OpenAI key.
# Copy to backend/.env to override.

# Optional live AI. When unset, AI features run in "DEMO MODE - NOT LIVE AI".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Storage: "json" (local files, default) or "memory" (lost on restart)
MYKSHEMA_STORAGE=json
# MYKSHEMA_DATA_DIR=./data
# MYKSHEMA_UPLOAD_DIR=./uploads
MYKSHEMA_MAX_UPLOAD_MB=10
MYKSHEMA_AUTO_SEED=true

# Token signing secret. If unset, a random secret is generated into the data dir.
MYKSHEMA_TOKEN_SECRET=
MYKSHEMA_TOKEN_TTL_HOURS=12

# Comma-separated frontend origins allowed by CORS
MYKSHEMA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MYKSHEMA_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
MYKSHEMA_AI_RATE_LIMIT=20
MYKSHEMA_ALLOW_DEMO_RESET=true
